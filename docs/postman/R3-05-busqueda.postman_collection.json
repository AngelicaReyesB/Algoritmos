{
  "info": {
    "name": "R3-05 Busqueda",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    }
  ],
  "item": [
    {
      "name": "R3-05 Busqueda: patron presente (model)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Responde 200', () => pm.response.to.have.status(200));",
              "const r = pm.response.json();",
              "pm.test('Los 3 algoritmos coinciden', () => pm.expect(r.coinciden).to.eql(true));",
              "pm.test('Hay 3 tiempos', () => pm.expect(r.tiempos.length).to.eql(3));",
              "pm.test('Un elemento por articulo', () => pm.expect(r.articulos.length).to.eql(r.totalArticulos));",
              "pm.test('Hay ocurrencias', () => pm.expect(r.totalOcurrencias).to.be.above(0));",
              "pm.test('Cada articulo: los 3 algoritmos cuentan lo mismo', () => r.articulos.forEach(a => { pm.expect(a.ocurrencias['KMP']).to.eql(a.posiciones.length); pm.expect(a.ocurrencias['Boyer-Moore']).to.eql(a.posiciones.length); pm.expect(a.ocurrencias['Rabin-Karp']).to.eql(a.posiciones.length); }));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/busqueda?patron=model",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "busqueda"
          ],
          "query": [
            {
              "key": "patron",
              "value": "model"
            }
          ]
        }
      }
    },
