{
  "info": {
    "_postman_id": "d09346f1-72b4-4f4c-8a31-a72f4548237a",
    "name": "Ranking API - Análisis de Algoritmos",
    "description": "Pruebas de la API REST del seguimiento: ranking de términos con Counting, Radix y Bucket Sort.\n\nRequisitos: PostgreSQL en Docker (`docker compose up -d`) y la aplicación corriendo (`./mvnw spring-boot:run`).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Artículos",
      "item": [
        {
          "name": "Listar artículos",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 200 OK\", () => pm.response.to.have.status(200));",
                  "",
                  "const articulos = pm.response.json();",
                  "",
                  "pm.test(\"Devuelve una lista con 20 artículos\", () => {",
                  "    pm.expect(articulos).to.be.an(\"array\").with.lengthOf(20);",
                  "});",
                  "",
                  "pm.test(\"Cada artículo tiene archivo, resumen y la marca manual\", () => {",
                  "    articulos.forEach(a => {",
                  "        pm.expect(a).to.have.property(\"archivo\").that.is.a(\"string\").and.not.empty;",
                  "        pm.expect(a).to.have.property(\"resumen\").that.is.a(\"string\").and.not.empty;",
                  "        pm.expect(a).to.have.property(\"manual\").that.is.a(\"boolean\");",
                  "    });",
                  "});",
                  "",
                  "pm.test(\"El artículo 20 tiene la corrección manual\", () => {",
                  "    const a20 = articulos.find(a => a.archivo === \"20_generative_agents.pdf\");",
                  "    pm.expect(a20, \"no existe 20_generative_agents.pdf\").to.exist;",
                  "    pm.expect(a20.manual).to.be.true;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/articulos",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "articulos"
              ]
            },
            "description": "Devuelve los 20 artículos cargados en la base de datos."
          }
        }
      ]
    },
    {
      "name": "Ranking",
      "item": [
        {
          "name": "Top 15 (por defecto)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 200 OK\", () => pm.response.to.have.status(200));",
                  "",
                  "const r = pm.response.json();",
                  "const nombres = [\"Counting Sort\", \"Radix Sort\", \"Bucket Sort\"];",
                  "const top = Number(pm.request.url.query.get(\"top\") || 15);",
                  "",
                  "pm.test(\"Incluye los 3 algoritmos\", () => {",
                  "    pm.expect(Object.keys(r.rankings)).to.have.members(nombres);",
                  "});",
                  "",
                  "pm.test(\"Cada ranking tiene \" + top + \" términos\", () => {",
                  "    nombres.forEach(n => pm.expect(r.rankings[n], n).to.have.lengthOf(Math.min(top, r.terminosDistintos)));",
                  "});",
                  "",
                  "pm.test(\"Los 3 rankings son idénticos (coinciden = true)\", () => {",
                  "    pm.expect(r.coinciden).to.be.true;",
                  "    const referencia = JSON.stringify(r.rankings[\"Counting Sort\"]);",
                  "    nombres.forEach(n => pm.expect(JSON.stringify(r.rankings[n]), n).to.eql(referencia));",
                  "});",
                  "",
                  "pm.test(\"Ordenado de mayor a menor frecuencia\", () => {",
                  "    const f = r.rankings[\"Counting Sort\"].map(t => t.frecuencia);",
                  "    for (let i = 1; i < f.length; i++) {",
                  "        pm.expect(f[i - 1], \"posición \" + i).to.be.at.least(f[i]);",
                  "    }",
                  "});",
                  "",
                  "pm.test(\"El primer término tiene la frecuencia máxima (k)\", () => {",
                  "    pm.expect(r.rankings[\"Counting Sort\"][0].frecuencia).to.eql(r.frecuenciaMaxima);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/ranking",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "ranking"
              ]
            },
            "description": "Top 15 de los tres algoritmos. Sin parámetro `top` usa 15."
          }
        },
