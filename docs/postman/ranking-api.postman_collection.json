    {
      "name": "Tiempos",
      "item": [
        {
          "name": "Medir tiempos",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 200 OK\", () => pm.response.to.have.status(200));",
                  "",
                  "const r = pm.response.json();",
                  "const etapas = [",
                  "    \"Extraccion PDF (PDFBox)\", \"Lectura de abstracts (BD)\", \"Preprocesamiento\",",
                  "    \"Conteo de frecuencias\", \"Counting Sort\", \"Radix Sort\", \"Bucket Sort\"",
                  "];",
                  "",
                  "pm.test(\"Mide las 7 etapas\", () => {",
                  "    pm.expect(r.resultados.map(x => x.etapa)).to.eql(etapas);",
                  "});",
                  "",
                  "pm.test(\"Las estadísticas son coherentes (0 <= mínimo <= media, desviación >= 0)\", () => {",
                  "    r.resultados.forEach(x => {",
                  "        pm.expect(x.minimoMs, x.etapa).to.be.at.least(0);",
                  "        pm.expect(x.minimoMs, x.etapa).to.be.at.most(x.mediaMs);",
                  "        pm.expect(x.desviacionMs, x.etapa).to.be.at.least(0);",
                  "    });",
                  "});",
                  "",
                  "pm.test(\"Los 3 algoritmos producen el mismo ranking\", () => {",
                  "    pm.expect(r.coinciden).to.be.true;",
                  "});",
                  "",
                  "pm.test(\"Incluye los datos del equipo\", () => {",
                  "    pm.expect(r.equipo.nucleos).to.be.above(0);",
                  "    pm.expect(r.equipo.memoriaTotalMb).to.be.above(0);",
                  "    pm.expect(r.equipo.versionJava).to.be.a(\"string\").and.not.empty;",
                  "});",
                  "",
                  "// Muestra la tabla de tiempos en la consola de Postman (View > Show Postman Console)",
                  "console.table(r.resultados);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/tiempos",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "tiempos"
              ]
            },
            "description": "Ejecuta la medición completa (~4 s): extracción PDF, lectura BD, preprocesamiento, conteo y los 3 algoritmos."
          }
        }
      ]
    }
  ],
